<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="Connection" app:iconSpaceReserved="false">
        <Preference android:key="connection_status" android:title="Listener and addresses" app:iconSpaceReserved="false" />
        <EditTextPreference android:key="server_port" android:title="Port" android:defaultValue="4444" app:iconSpaceReserved="false" />
        <EditTextPreference android:key="bind_address" android:title="Bind address" android:defaultValue="0.0.0.0"
            android:dialogMessage="Use a local hotspot, VPN, or other numeric IP address. 0.0.0.0 listens on all IPv4 interfaces; :: on all IPv6 interfaces (and IPv4 where supported). An unavailable address will not fall back to all interfaces."
            app:iconSpaceReserved="false" />
        <Preference android:key="apply_connection" android:title="Apply connection changes"
            android:summary="Restart listener with saved port, address and TLS settings. Connected clients will disconnect."
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Authentication" app:iconSpaceReserved="false">
        <CheckBoxPreference android:key="enable_auth" android:title="Require authentication" android:defaultValue="true" app:iconSpaceReserved="false" />
        <EditTextPreference android:key="username" android:title="Username" android:persistent="false" app:iconSpaceReserved="false" />
        <EditTextPreference android:key="password" android:title="Password" android:persistent="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="TLS" app:iconSpaceReserved="false">
        <ListPreference android:key="tls_version" android:title="TLS version" android:defaultValue="1.3"
            android:entries="@array/tls_version_entries" android:entryValues="@array/tls_version_values" app:iconSpaceReserved="false" />
        <Preference android:key="certificate_path" android:title="Certificate" app:iconSpaceReserved="false" />
        <EditTextPreference android:key="certificate_password" android:title="Certificate password" android:persistent="false" app:iconSpaceReserved="false" />
        <Preference android:key="test_certificate" android:title="Validate certificate" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Recording" app:iconSpaceReserved="false">
        <Preference android:key="recording_storage_uri" android:title="Storage folder" app:iconSpaceReserved="false" />
        <Preference android:key="reset_recording_storage" android:title="Use default folder" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Startup" app:iconSpaceReserved="false">
        <CheckBoxPreference android:key="start_on_boot" android:title="Start listener on boot"
            android:summary="Camera stays stopped until Start is requested" android:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
