<resources>
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">#202324</item>
        <item name="colorPrimaryDark">#202324</item>
        <item name="colorAccent">#80CBC4</item>
        <item name="android:windowBackground">#202324</item>
        <item name="android:colorBackground">#202324</item>
        <item name="android:textColorPrimary">#F0EFEB</item>
        <item name="android:textColorSecondary">#BCBFBC</item>
        <item name="android:navigationBarColor">#202324</item>
        <item name="android:statusBarColor">#202324</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="HomeControl">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:tint">#F0EFEB</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
